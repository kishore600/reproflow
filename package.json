{
  "name": "reproflow",
  "version": "0.1.0",
  "description": "Saved, replayable browser flows and one-call debug evidence for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reproflow": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema",
    "plugin",
    "examples",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "playwright",
    "browser",
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "debugging",
    "e2e"
  ],
  "scripts": {
    "build": "tsup && node dist/cli/index.js schema --out schema/flow.schema.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fastest-levenshtein": "^1.0.16",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
